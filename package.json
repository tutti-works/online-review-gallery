{
  "name": "online-review-gallery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:review-labels": "node --experimental-strip-types --test test/reviewLabels.test.mjs",
    "test:storage-rules": "firebase emulators:exec --only auth,firestore,storage --config firebase.emulators.json \"node --test test/storage.rules.test.js\"",
    "emulators": "firebase emulators:start --config firebase.emulators.json",
    "cleanup:showcase": "node scripts/cleanup-showcase.js",
    "audit:storage-privacy": "node scripts/audit-storage-privacy.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "konva": "^9.3.16",
    "lucide-react": "^0.552.0",
    "next": "^14.2.35",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-konva": "^18.2.9"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.0.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "websocket-driver": "^0.7.5"
  }
}
