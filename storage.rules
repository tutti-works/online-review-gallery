rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/userRoles/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/userRoles/$(request.auth.token.email)).data.role == 'admin';
    }

    function isShowcaseDomainAllowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@([A-Za-z0-9-]+\\.)*musashino-u\\.ac\\.jp$');
    }

    // 通常ギャラリー: Firebase Auth 認証済みユーザーのみ読み取り可能
    match /galleries/{galleryId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Showcase: 学内ドメインの認証済みユーザーのみ読み取り可能
    match /showcase/{galleryId}/{allPaths=**} {
      allow read: if isShowcaseDomainAllowed();
      allow write: if isAdmin() && isShowcaseDomainAllowed();
    }

    // 一時ファイル: クライアントからは全面拒否する。
    // Admin SDK / Cloud Run / Cloud Functions は Storage Rules をバイパスする。
    match /unprocessed/{importJobId}/{allPaths=**} {
      allow read, write: if false;
    }

    // その他のパスは拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
