rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー関数: ユーザーが管理者かどうかを確認
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data.role == 'admin';
    }

    // ヘルパー関数: ユーザーが認証済みかどうかを確認
    function isAuthenticated() {
      return request.auth != null;
    }

    // 専用ギャラリー用: 許可ドメインのチェック
    function isShowcaseDomainAllowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@([A-Za-z0-9-]+\\.)*musashino-u\\.ac\\.jp$');
    }

    // ロール変更は認証・最終管理者チェックを行うサーバーAPIのみ（Admin SDK）。
    // 自分のロール読み取りは従来どおり。クライアント直接書き込みは禁止。
    match /userRoles/{email} {
      allow read: if isAuthenticated() && request.auth.token.email == email;
      allow write: if false;
    }

    // galleries コレクション: 管理者のみ作成・更新可能、認証済みユーザーは読み取り可能
    match /galleries/{galleryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // archivedCourses: 授業の表示区分だけを管理する
    match /archivedCourses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // artworks コレクション: 管理者のみ作成・更新・削除可能、認証済みユーザーは読み取り可能
    match /artworks/{artworkId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // likes コレクション: 管理者のみ作成・削除可能、認証済みユーザーは読み取り可能
    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.userEmail == request.auth.token.email;
    }

    // showcaseGalleries: 専用ギャラリーの設定/同期データ
    match /showcaseGalleries/{galleryId} {
      allow read: if isAuthenticated() && isShowcaseDomainAllowed();
      allow write: if isAdmin() && isShowcaseDomainAllowed();
    }

    // importJobs コレクション: 管理者のみアクセス可能
    match /importJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // その他のドキュメントへのアクセスは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
