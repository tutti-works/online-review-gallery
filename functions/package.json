{
  "name": "functions",
  "description": "Cloud Functions for Online Review Gallery",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/httpSecurity.test.js",
    "smoke:container": "node test/containerSmoke.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "gcp-build": "npm run build"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/tasks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^181.0.0",
    "pdf2pic": "^3.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "jws": "^3.2.3"
  },
  "private": true
}
